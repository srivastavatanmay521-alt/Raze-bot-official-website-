{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run typecheck:libs && pnpm --filter @workspace/razebot-site run build",
  "outputDirectory": "artifacts/razebot-site/dist/public",
  "framework": null,
  "env": {
    "BASE_PATH": "/",
    "NODE_ENV": "production",
    "ADMIN_EMAIL": "support@razebot.site",
    "ADMIN_PASSWORD": "@admin_password",
    "ADMIN_TOKEN": "@admin_token"
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
